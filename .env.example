APP_NAME="Local Works"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite is the zero-service local/test default. Laravel Cloud may provide DB_URL.
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite
# For MySQL production, set DB_CONNECTION=mysql plus DB_HOST, DB_PORT,
# DB_DATABASE, DB_USERNAME, and DB_PASSWORD (or provide DB_URL).

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Recipient for new Digital Friction Audit and general-contact notifications.
LOCAL_WORKS_INTAKE_EMAIL=intake@example.com

# Configure a production mail transport before launch (Laravel defaults to log locally).
MAIL_MAILER=log
# Standard SMTP settings when MAIL_MAILER=smtp:
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SCHEME=

# Privacy-conscious aggregate analytics. Leave disabled for local, test, and preview use.
# Production requires ANALYTICS_ENABLED=true and the exact domain configured in Plausible.
ANALYTICS_ENABLED=false
ANALYTICS_PROVIDER=plausible
ANALYTICS_SITE_ID=

VITE_APP_NAME="${APP_NAME}"

# Production should set APP_ENV=production, APP_DEBUG=false, APP_URL=https://..., and
# SESSION_SECURE_COOKIE=true after HTTPS/proxy handling has been verified.
# Set MAIL_FROM_ADDRESS and MAIL_FROM_NAME alongside the selected production mailer.
SESSION_SECURE_COOKIE=false
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Local Works"
